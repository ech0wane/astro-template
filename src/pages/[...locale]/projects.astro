---
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import { projects } from "@/data/projects";
import {
  DEFAULT_LOCALE,
  SUPPORTED_LOCALES,
  type LocaleKey,
} from "@/i18n/config";
import { translateFor } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () =>
  SUPPORTED_LOCALES.map(locale => ({
    params: { locale: locale === DEFAULT_LOCALE ? undefined : locale },
  }))) satisfies GetStaticPaths;

const locale = Astro.currentLocale as LocaleKey;
const t = translateFor(locale);
---

<Layout
  title={`${t("projects")} | ${t("site.title")}`}
  description={t("projects.desc")}
>
  <Header />
  <Main pageTitle={t("projects")} pageDesc={t("projects.desc")}>
    <div class="space-y-8">
      {
        projects.map(project => (
          <article class="rounded-lg border border-border bg-muted/20 p-5 sm:p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h2 class="text-xl font-semibold text-accent">
                  {project.name}
                </h2>
                <p class="mt-2">{project.summary[locale]}</p>
              </div>
              <div class="flex shrink-0 flex-wrap gap-3">
                <LinkButton
                  href={project.repoUrl}
                  class="rounded border border-border px-3 py-2 text-sm font-medium"
                >
                  {t("projects.repo")}
                  <IconArrowRight class="ms-1 inline-block size-4 rtl:rotate-180" />
                </LinkButton>
              </div>
            </div>

            <p class="mt-5 leading-7">{project.description[locale]}</p>

            <div class="mt-5 grid gap-5 lg:grid-cols-[1fr_16rem]">
              <div>
                <h3 class="font-semibold">{t("projects.highlights")}</h3>
                <ul class="mt-2 list-disc space-y-2 ps-5">
                  {project.highlights[locale].map(highlight => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="font-semibold">{t("projects.stack")}</h3>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {project.stack.map(item => (
                    <li class="rounded-full border border-border px-3 py-1 text-sm">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
